    {"id": "strict-tdd", "purpose": "Conservar red, green, triangulate y refactor.", "authority": "ADR-0002", "inputs": ["stages"], "outputs": ["evidence"], "invariants": ["tests-first"], "maturity": "enforced", "implementation": "strict_tdd"},
