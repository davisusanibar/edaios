{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaios.local/schemas/authority-registry/v1",
  "title": "EDAIOS AuthorityRegistry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "initiative", "version", "actors"],
  "properties": {
    "schema": {"const": "edaios.authority-registry/v1"},
    "initiative": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "actors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["actor_id", "type", "roles", "capabilities", "active"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "type": {"enum": ["human", "service", "agent"]},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9:-]*$"}},
          "active": {"type": "boolean"}
        }
      }
    }
  }
}
