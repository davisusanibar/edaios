{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaios.local/schemas/initiative-manifest/v1",
  "title": "EDAIOS InitiativeManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "namespace", "owner", "value_owner", "core_compatibility", "conformance_profile", "policy_profile", "sensitivity_profile", "authority_registry", "sources", "capabilities", "required_gates", "evidence_path", "lifecycle", "human_approval_required"],
  "properties": {
    "schema": {"const": "edaios.initiative-manifest/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"},
    "owner": {"type": "string", "minLength": 1},
    "value_owner": {"type": "string", "minLength": 1},
    "core_compatibility": {"type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+ <\\d+\\.\\d+\\.\\d+$"},
    "conformance_profile": {"enum": ["initiative-adoption", "federation"]},
    "policy_profile": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"},
    "sensitivity_profile": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"},
    "authority_registry": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "authority"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"},
          "authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9:-]*$"}},
    "required_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "evidence_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.\\/-]+$"},
    "lifecycle": {"enum": ["draft", "active", "suspended", "retired"]},
    "human_approval_required": {"const": true}
  }
}
