{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaios.local/schemas/git-cutover-target/v1",
  "title": "EDAIOS GitCutoverTarget v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "component", "version", "repository", "canonical_branch", "required_checks", "provider_evidence_kinds", "attestation_publication"],
  "properties": {
    "schema": {"const": "edaios.git-cutover-target/v1"},
    "status": {"const": "proposed"},
    "component": {"const": "edaios-core"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9.-]+(?:/[A-Za-z0-9._-]+)+$"},
    "canonical_branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"}},
    "provider_evidence_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["branch-protection", "default-branch", "git-refs", "required-checks"]}},
    "attestation_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowed_kinds"],
      "properties": {
        "required": {"const": true},
        "allowed_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["attestation-store", "release-asset"]}}
      }
    }
  }
}
