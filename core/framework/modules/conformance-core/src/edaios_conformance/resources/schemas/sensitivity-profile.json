{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaios.local/schemas/sensitivity-profile/v1",
  "title": "EDAIOS SensitivityProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "level", "data_classes", "required_controls", "forbidden_routes", "approval_roles"],
  "properties": {
    "schema": {"const": "edaios.sensitivity-profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "level": {"enum": ["T0", "T1", "T2", "T3"]},
    "data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "required_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "forbidden_routes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "approval_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
  }
}
