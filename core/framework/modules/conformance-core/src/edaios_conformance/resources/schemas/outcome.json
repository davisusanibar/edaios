{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edaios.local/schemas/outcome/v1",
  "title": "EDAIOS Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "initiative", "owner", "claim", "metric", "baseline", "observation", "source", "observed_at", "scope", "status", "evidence"],
  "properties": {
    "schema": {"const": "edaios.outcome/v1"},
    "id": {"type": "string", "pattern": "^OUT-[0-9]{4}$"},
    "initiative": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "owner": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "baseline": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "verified", "rejected"]},
    "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
