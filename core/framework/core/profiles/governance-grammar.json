{
  "schema": "edaios.governance-grammar/v1",
  "version": "1.0.0",
  "entities": [
    "Foundation",
    "Core",
    "Consumer",
    "KnowledgeObject",
    "ConstitutionArticle",
    "ADR",
    "RFC",
    "Feature",
    "Gate",
    "Evidence",
    "Outcome",
    "DerivedView",
    "FutureExtension",
    "Identity",
    "Manifesto",
    "Vision",
    "Mission",
    "Value",
    "Principle",
    "Philosophy",
    "Strategy",
    "Constitution",
    "Article",
    "Ontology",
    "Standard",
    "Governance",
    "Pattern",
    "Playbook",
    "Constraint"
  ],
  "constraints": [
    {"id": "INV-001", "aplica_a": ["Foundation", "Core", "Consumer"], "verificado_por": ["KOM", "BASELINE-SURFACE"]},
    {"id": "INV-002", "aplica_a": ["DerivedView"], "verificado_por": ["FND-PROJECTION", "CATALOG-PROJECTION", "AGENT-PARITY", "CORE-BASE-DEMO"]},
    {"id": "INV-003", "aplica_a": ["Evidence", "Gate", "Outcome"], "verificado_por": ["SDD-CONTRACT", "TRACEABILITY"]},
    {"id": "INV-004", "aplica_a": ["FutureExtension"], "verificado_por": ["CLAIM-SURFACE", "BASELINE-SURFACE"]},
    {"id": "INV-005", "aplica_a": ["KnowledgeObject"], "verificado_por": ["KOM", "TRACEABILITY"]},
    {"id": "INV-006", "aplica_a": ["KnowledgeObject"], "verificado_por": ["KOM-VR-01"]},
    {"id": "INV-007", "aplica_a": ["KnowledgeObject", "Ontology"], "verificado_por": ["KOM-VR-02"]},
    {"id": "INV-008", "aplica_a": ["KnowledgeObject"], "verificado_por": ["KOM-VR-09", "KOM-VR-10"]},
    {"id": "INV-009", "aplica_a": ["RFC", "ADR"], "verificado_por": ["TRACEABILITY", "CATALOG-PROJECTION"]},
    {"id": "INV-010", "aplica_a": ["KnowledgeObject"], "verificado_por": ["DERIVA-PROSA"]},
    {"id": "INV-011", "aplica_a": ["Feature", "ADR"], "verificado_por": ["SDD-CONTRACT"]}
  ],
  "id_patterns": {
    "ADR": "^ADR-[0-9]{4}$",
    "RFC": "^RFC-[0-9]{4}$",
    "KO": "^(?:KO-[A-Z0-9][A-Z0-9-]*|ART-[0-9]{3}|PAT-[0-9]{3}|PLB-[0-9]{3})$",
    "feature": "^EDAIOS-[A-Z0-9][A-Z0-9-]*$",
    "requirement": "^FR-[0-9]{3}$",
    "success_criterion": "^SC-[0-9]{3}$",
    "task": "^T[0-9]{3}$"
  },
  "ko_lifecycle": [
    "Borrador",
    "Propuesto",
    "Ratificado",
    "Derogado"
  ],
  "lifecycle_transitions": {
    "Borrador": ["Borrador", "Propuesto"],
    "Propuesto": ["Propuesto", "Ratificado"],
    "Ratificado": ["Ratificado", "Derogado"],
    "Derogado": ["Derogado"]
  },
  "state_mappings": {
    "KO": {
      "Borrador": "Borrador",
      "Propuesto": "Propuesto",
      "Ratificado": "Ratificado",
      "Derogado": "Derogado"
    },
    "ADR": {
      "Propuesto": "Propuesto",
      "Aceptado": "Ratificado",
      "Derogado": "Derogado"
    },
    "RFC": {
      "Borrador": "Borrador",
      "Propuesto": "Propuesto",
      "Ratificado": "Ratificado",
      "Rechazado": "Derogado",
      "Derogado": "Derogado"
    },
    "Feature": {
      "Borrador": "Borrador",
      "Propuesto": "Propuesto",
      "Cerrado": "Ratificado"
    }
  },
  "authority_order": ["Foundation", "Core", "Consumer"],
  "authority_aliases": {
    "Framework": "Core"
  },
  "root_authorities": ["Foundation"],
  "relations": {
    "derives_from": {"domain": ["KO"], "range": ["KO"]},
    "governs": {"domain": ["Foundation", "Core"], "range": ["KO"]},
    "consumes": {"domain": ["Consumer"], "range": ["Core"]},
    "implements": {"domain": ["KO"], "range": ["Feature", "ADR"]},
    "verified_by": {"domain": ["KO"], "range": ["Gate", "Evidence"]},
    "decides": {"domain": ["ADR"], "range": ["KO"]},
    "resolves": {"domain": ["ADR"], "range": ["RFC"]},
    "supersedes": {"domain": ["KO"], "range": ["KO"]},
    "projects": {"domain": ["DerivedView"], "range": ["KO"]},
    "references": {"domain": ["KO"], "range": ["KO"]},
    "validates": {"domain": ["Gate"], "range": ["KO"]},
    "represents": {"domain": ["DerivedView"], "range": ["KO"]}
  }
}
